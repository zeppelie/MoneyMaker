{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "moneymaker",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((q,s)=>require('fs').createReadStream('.'+(q.url==='/'?'/index.html':q.url.split('?')[0])).on('error',()=>s.end()).pipe(s)).listen(8123)"],
      "port": 8123
    }
  ]
}
